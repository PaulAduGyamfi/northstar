{
  "$schema": "./node_modules/turbo/schema.json",
  "globalPassThroughEnv": ["TMPDIR"],
  "tasks": {
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    }
  }
}
