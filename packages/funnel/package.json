{
  "name": "@northstar/funnel",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "funnel": "turbo run build --filter=@northstar/funnel && node --env-file-if-exists=../../.env.app dist/bin.js"
  },
  "dependencies": {
    "@northstar/db": "workspace:*",
    "@northstar/domain": "workspace:*",
    "@northstar/gateways": "workspace:*",
    "@northstar/inbox": "workspace:*",
    "@northstar/llm": "workspace:*",
    "@northstar/profile": "workspace:*",
    "@northstar/sources": "workspace:*",
    "@opentelemetry/api": "1.10.0",
    "drizzle-orm": "0.45.4",
    "zod": "4.6.7"
  }
}
