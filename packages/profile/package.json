{
  "name": "@northstar/profile",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "profile": "turbo run build --filter=@northstar/profile && node --env-file-if-exists=../../.env dist/bin.js"
  },
  "dependencies": {
    "@northstar/db": "workspace:*",
    "@northstar/domain": "workspace:*",
    "@northstar/llm": "workspace:*",
    "@northstar/prompts": "workspace:*",
    "@opentelemetry/api": "1.10.0",
    "docx": "9.15.3",
    "drizzle-orm": "0.45.4",
    "mammoth": "1.13.0",
    "pdf-lib": "1.17.1",
    "unpdf": "2.1.0",
    "zod": "4.6.7"
  }
}
