{
  "name": "@northstar/sources",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "jobs": "turbo run build --filter=@northstar/sources && node --env-file-if-exists=../../.env.app dist/bin.js"
  },
  "dependencies": {
    "@northstar/db": "workspace:*",
    "@northstar/domain": "workspace:*",
    "@northstar/llm": "workspace:*",
    "@northstar/prompts": "workspace:*",
    "@opentelemetry/api": "1.9.1",
    "drizzle-orm": "0.45.4",
    "fast-xml-parser": "5.12.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@opentelemetry/sdk-trace-base": "2.12.1"
  }
}
