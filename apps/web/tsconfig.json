{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["es2024", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "declaration": false,
    "sourceMap": false,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": ["next.config.ts", "app", "src"],
  "exclude": ["node_modules", ".next"]
}
