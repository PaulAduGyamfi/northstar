{
  "manifest_version": 3,
  "name": "Save to Northstar",
  "version": "0.1.0",
  "description": "Save the job posting you are reading to your own Northstar.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "action": {
    "default_title": "Save to Northstar",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  }
}
